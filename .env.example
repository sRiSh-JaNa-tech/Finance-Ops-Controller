# Google Gemini / Vertex AI Configuration Template
# Replace with your actual Gemini API Key from Google AI Studio or Vertex AI
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY_HERE
GEMINI_API_KEY=YOUR_GOOGLE_API_KEY_HERE

# Model Target
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional: Google Cloud Vertex AI Enterprise Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
VERTEX_PROJECT_ID=your-gcp-project-id
VERTEX_LOCATION=us-central1

# Path to Service Account JSON (if using GCP IAM credentials instead of API key)
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
